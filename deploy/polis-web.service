[Unit]
Description=Polis Web Frontend (Next.js)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/polis/web/.next/standalone
ExecStartPre=/bin/bash -c "cp -rn /root/polis/web/.next/static /root/polis/web/.next/standalone/.next/static 2>/dev/null; cp -rn /root/polis/web/public /root/polis/web/.next/standalone/public 2>/dev/null; true"
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000
StandardOutput=append:/root/polis/web.log
StandardError=append:/root/polis/web.log

[Install]
WantedBy=multi-user.target
